# Имя бота и короткое имя Mini App — для ссылок «скопировать приглашение»
VITE_BOT_USERNAME=
VITE_APP_SHORT_NAME=
# Если API на другом домене (по умолчанию — тот же адрес, в разработке Vite проксирует /api)
VITE_API_URL=
# Ключ Яндекс Карт («JavaScript API и HTTP Геокодер», https://developer.tech.yandex.ru).
# Без ключа открывается только карта, а поиск мест и адресов выключен.
VITE_YANDEX_MAPS_KEY=
