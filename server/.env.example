# Токен от @BotFather
BOT_TOKEN=
# Имя бота без @, например skhodka_bot
BOT_USERNAME=
# Оставьте пустым: ссылки ведут на главное Mini App бота (t.me/<бот>?startapp=…).
# Нужно только для отдельного приложения из /newapp (ссылка t.me/<бот>/<имя>).
APP_SHORT_NAME=
# Публичный HTTPS-адрес Mini App (в разработке — адрес туннеля на этот сервер, порт 8787)
WEBAPP_URL=https://example.trycloudflare.com

PORT=8787
# Слушать только этот компьютер — туннель подключается локально
HOST=127.0.0.1
DB_PATH=data/skhodka.db
# Папка со сборкой Mini App, которую сервер раздаёт в продакшене
STATIC_DIR=../webapp/dist
# Каталог мест (пример лежит в data/places.json — замените на места своего города)
PLACES_PATH=data/places.json
# Часовой пояс, в котором организаторы указывают время
TZ=Asia/Tashkent

# 1 — разрешить вход без Telegram (заголовок "Authorization: dev <id>").
# Только для локальной разработки!
DEV_MODE=1

# Ключ «API поиска по организациям» Яндекса (developer.tech.yandex.ru).
# Без него поиск в Mini App показывает подсказки без координат: точку ставят вручную.
YANDEX_SEARCH_KEY=
